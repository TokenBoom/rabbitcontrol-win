<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      RequestedTheme="Dark" Background="#131B25">
  <Grid.RowDefinitions>
    <RowDefinition Height="68"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="44"/>
  </Grid.RowDefinitions>
  <Grid Margin="24,0">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
      <Border Width="34" Height="34" CornerRadius="9" Background="#8EE8C9">
        <Path VerticalAlignment="Center" HorizontalAlignment="Center" Fill="#163B36"
              Data="M 1,17 L 7,3 L 11,3 L 8,13 L 16,2 L 20,2 L 14,16 L 9,21 L 4,21 Z"/>
      </Border>
      <TextBlock Text="RabbitControl" VerticalAlignment="Center" FontSize="21" FontWeight="SemiBold" Foreground="#F0F4F8"/>
    </StackPanel>
  </Grid>
  <Grid Grid.Row="1" Margin="20,0" Background="#101922" BorderBrush="#354553" BorderThickness="1">
    <Viewbox Stretch="Uniform">
      <SwapChainPanel x:Name="Framebuffer"/>
    </Viewbox>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="15" IsHitTestVisible="False">
      <Viewbox Width="52" Height="46" HorizontalAlignment="Center">
        <Path Stroke="#8EE8C9" StrokeThickness="2" StrokeLineJoin="Round"
              Data="M 2,2 L 50,2 L 50,32 L 2,32 Z M 26,32 L 26,40 M 16,40 L 36,40"/>
      </Viewbox>
      <TextBlock Text="No active session" FontSize="23" FontWeight="SemiBold" Foreground="#EFF6FA" HorizontalAlignment="Center"/>
    </StackPanel>
  </Grid>
  <Grid Grid.Row="2" Margin="24,0">
    <TextBlock Text="Remote desktop" FontSize="13" VerticalAlignment="Center" Foreground="#ADC0CD"/>
    <TextBlock x:Name="DesktopSize" FontFamily="Consolas" FontSize="13" HorizontalAlignment="Right"
               VerticalAlignment="Center" Foreground="#ADC0CD"/>
  </Grid>
</Grid>
