<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      RequestedTheme="Light" x:Name="RootLayout">
  <Grid.RowDefinitions>
    <RowDefinition Height="40"/>
    <RowDefinition Height="*"/>
  </Grid.RowDefinitions>

  <!-- ===== 自绘标题栏（固定窗口：仅最小化/关闭） ===== -->
  <Grid>
    <Border x:Name="DragRegion" Background="Transparent"/>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0" Spacing="8" IsHitTestVisible="False">
      <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE968;" FontSize="14" Foreground="{ThemeResource PrimaryBrush}"/>
      <TextBlock x:Name="AppTitle" Text="RabbitControl" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
      <Button x:Name="Minimize" AutomationProperties.Name="最小化" Content="&#xE921;" Style="{StaticResource CaptionButton}" Width="48" Height="48"/>
      <Button x:Name="CloseWindow" AutomationProperties.Name="关闭" Content="&#xE8BB;" Style="{StaticResource CaptionButton}" Width="48" Height="48"/>
    </StackPanel>
  </Grid>

  <!-- ===== 已登录主壳：侧栏 + 内容区 ===== -->
  <Grid x:Name="MainShell" Grid.Row="1" Visibility="Collapsed">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="200"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- 侧栏 -->
    <Border Background="{ThemeResource SidebarBackgroundBrush}" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,1,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1" Spacing="2">
          <ToggleButton x:Name="NavDevices" Style="{StaticResource NavItem}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7F4;" FontSize="16"/>
              <TextBlock Text="我的设备" Style="{StaticResource BodyText}"/>
            </StackPanel>
          </ToggleButton>
          <ToggleButton x:Name="NavAssist" Style="{StaticResource NavItem}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE720;" FontSize="16"/>
              <TextBlock Text="开始协助" Style="{StaticResource BodyText}"/>
            </StackPanel>
          </ToggleButton>
          <ToggleButton x:Name="NavFavorites" Style="{StaticResource NavItem}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE735;" FontSize="16"/>
              <TextBlock Text="收藏设备" Style="{StaticResource BodyText}"/>
            </StackPanel>
          </ToggleButton>
          <ToggleButton x:Name="NavSettings" Style="{StaticResource NavItem}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE713;" FontSize="16"/>
              <TextBlock Text="设置" Style="{StaticResource BodyText}"/>
            </StackPanel>
          </ToggleButton>
        </StackPanel>
        <!-- 设置（UU 底部入口） -->
        <Border Grid.Row="3" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,1,0,0" Padding="14,10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE713;" FontSize="16" Foreground="{ThemeResource TextSecondaryBrush}"/>
              <TextBlock x:Name="StatusText" Text="信令未连接" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
            </StackPanel>
            <Button x:Name="LogoutButton" Content="退出" Style="{StaticResource LinkButton}" Grid.Column="1" VerticalAlignment="Center"/>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <!-- 内容区 -->
    <Grid Grid.Column="1">

      <!-- 我的设备 -->
      <Grid x:Name="DevicesPage" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="24,20,24,12">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="我的设备" Style="{StaticResource TitleText}"/>
            <TextBlock x:Name="ServerOriginCaption" VerticalAlignment="Center" Style="{StaticResource CaptionText}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="RefreshDevices" Style="{StaticResource SecondaryButton}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72C;" FontSize="14"/>
                <TextBlock Text="刷新" Style="{StaticResource BodyText}"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>

        <!-- 被控状态横幅（M5 接通真实数据，M1 占位：被控中即展开） -->
        <Border x:Name="HostBanner" Grid.Row="1" Margin="24,0,24,12" CornerRadius="10" Background="{ThemeResource BannerGradient}" Padding="20,14" Visibility="Collapsed">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="14">
              <TextBlock Text="本机被控中" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource TextOnPrimaryBrush}" VerticalAlignment="Center"/>
              <TextBlock x:Name="BannerTimer" Text="00:00:00" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TextOnPrimaryBrush}" VerticalAlignment="Center"/>
              <TextBlock x:Name="BannerSub" Text="" FontSize="12" Foreground="#D8E4FF" VerticalAlignment="Center"/>
            </StackPanel>
            <Button x:Name="BannerDisconnect" Grid.Column="1" Content="断开所有远程" Style="{StaticResource SecondaryButton}" Height="32"/>
          </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" Padding="24,0,24,16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="DeviceListHost" Spacing="10"/>
        </ScrollViewer>
        <StackPanel x:Name="DevicesEmpty" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" IsHitTestVisible="False">
          <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7F4;" FontSize="42" Foreground="{ThemeResource OfflineBrush}"/>
          <TextBlock Text="账号下暂无设备" Style="{StaticResource SubtitleText}" HorizontalAlignment="Center"/>
          <TextBlock Text="在本机或其他设备登录后，设备会出现在这里" Style="{StaticResource CaptionText}" HorizontalAlignment="Center"/>
        </StackPanel>
      </Grid>

      <!-- 开始协助 -->
      <Grid x:Name="AssistPage" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="24,20,24,12">
          <TextBlock Text="远程协助" Style="{StaticResource TitleText}"/>
        </Grid>
        <ScrollViewer Grid.Row="1" Padding="24,0,24,16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="12">

            <!-- 本设备卡 -->
            <Border Style="{StaticResource CardBorder}">
              <StackPanel Spacing="14">
                <Grid>
                  <TextBlock Text="本设备" Style="{StaticResource SubtitleText}" VerticalAlignment="Center"/>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                    <TextBlock Text="允许他人远程协助" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                    <ToggleSwitch x:Name="AssistToggle" MinWidth="0" Margin="0" OnContent="" OffContent=""/>
                  </StackPanel>
                </Grid>
                <Border BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                      <TextBlock Text="本设备 ID" Style="{StaticResource CaptionText}"/>
                      <TextBlock x:Name="LocalIdText" Text="··· ··· ···" FontSize="30" FontWeight="Bold" FontFamily="Consolas" Foreground="{ThemeResource PrimaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="28,0,0,0" Spacing="4" VerticalAlignment="Center">
                      <TextBlock Text="验证方式 · 临时验证码" Style="{StaticResource CaptionText}"/>
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock x:Name="CodeMaskText" Text="—— 待被控验证接通 ——" FontSize="18" FontFamily="Consolas" VerticalAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}"/>
                        <Button x:Name="ToggleCodeButton" Content="&#xE7B3;" Style="{StaticResource CaptionButton}" IsEnabled="False" AutomationProperties.Name="显示或隐藏验证码"/>
                      </StackPanel>
                      <TextBlock Text="M5 被控链路接通后，每次远控结束自动轮换" Style="{StaticResource CaptionText}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                      <Button x:Name="CopyIdButton" Style="{StaticResource PrimaryButton}" Height="36">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8C8;" FontSize="14"/>
                          <TextBlock Text="复制并分享" Style="{StaticResource BodyText}" Foreground="{ThemeResource TextOnPrimaryBrush}"/>
                        </StackPanel>
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>
              </StackPanel>
            </Border>

            <!-- 远控伙伴设备卡 -->
            <Border Style="{StaticResource CardBorder}">
              <StackPanel Spacing="12">
                <TextBlock Text="远控伙伴设备" Style="{StaticResource SubtitleText}"/>
                <TextBlock Text="输入对方的 9 位设备 ID 发起远程控制" Style="{StaticResource CaptionText}"/>
                <Grid ColumnSpacing="10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="PeerCodeBox" PlaceholderText="例如 879 009 692" MaxLength="11" Height="40" FontFamily="Consolas" FontSize="16" HorizontalAlignment="Stretch"/>
                  <Button x:Name="ConnectPeerButton" Grid.Column="1" Content="连接" Style="{StaticResource PrimaryButton}" Width="110" IsEnabled="False"/>
                  <Button x:Name="PeerAdvancedButton" Grid.Column="2" Content="选项" Style="{StaticResource SecondaryButton}"/>
                </Grid>
                <StackPanel x:Name="PeerAdvancedRow" Orientation="Horizontal" Spacing="16" Visibility="Collapsed">
                  <PasswordBox x:Name="PeerPasswordBox" PlaceholderText="对方设备的连接密码（可选）" Width="260"/>
                  <CheckBox x:Name="WatchOnlyCheck" Content="仅观看，不控制"/>
                </StackPanel>
                <TextBlock x:Name="AssistError" Style="{StaticResource CaptionText}" Foreground="{ThemeResource DangerBrush}" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>

            <!-- 最近 / 收藏 -->
            <Border Style="{StaticResource CardBorder}">
              <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <ToggleButton x:Name="HistoryTabRecent" Content="最近连接" CornerRadius="6" BorderThickness="0" Padding="14,6" Background="{ThemeResource PrimaryBrush}" IsChecked="True">
                    <ToggleButton.Resources/>
                  </ToggleButton>
                  <ToggleButton x:Name="HistoryTabFav" Content="收藏" CornerRadius="6" BorderThickness="0" Padding="14,6" Background="Transparent"/>
                </StackPanel>
                <StackPanel x:Name="HistoryListHost" Spacing="8"/>
                <TextBlock x:Name="HistoryEmpty" Text="暂无记录" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" Margin="0,6"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- 收藏设备 -->
      <Grid x:Name="FavoritesPage" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="24,20,24,12">
          <TextBlock Text="收藏设备" Style="{StaticResource TitleText}"/>
        </Grid>
        <Grid Grid.Row="1">
          <ScrollViewer Padding="24,0,24,16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="FavoritesListHost" Spacing="10"/>
          </ScrollViewer>
          <StackPanel x:Name="FavoritesEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" IsHitTestVisible="False">
            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE735;" FontSize="42" Foreground="{ThemeResource OfflineBrush}"/>
            <TextBlock Text="还没有收藏设备" Style="{StaticResource SubtitleText}" HorizontalAlignment="Center"/>
            <TextBlock Text="在设备列表的「⋯」菜单里收藏设备，它会出现在这里" Style="{StaticResource CaptionText}" HorizontalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Grid>

      <!-- 设置 -->
      <Grid x:Name="SettingsPage" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="设置" Style="{StaticResource DisplayText}" Margin="24,20,24,10"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="24" Margin="24,0,24,10">
          <ToggleButton x:Name="TabGeneral" Content="常规" FontWeight="SemiBold" BorderThickness="0" Background="Transparent" Padding="0,4" IsChecked="True"/>
          <ToggleButton x:Name="TabSecurity" Content="安全" BorderThickness="0" Background="Transparent" Padding="0,4"/>
          <ToggleButton x:Name="TabNetwork" Content="网络" BorderThickness="0" Background="Transparent" Padding="0,4"/>
        </StackPanel>
        <ScrollViewer Grid.Row="2" Padding="24,0,24,16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxWidth="720" HorizontalAlignment="Left">
          <StackPanel Spacing="4">

            <StackPanel x:Name="PanelGeneral" Spacing="10">
              <TextBlock Text="画质" Style="{StaticResource CaptionText}" Margin="0,4"/>
              <Border Style="{StaticResource SettingRowBorder}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="2">
                    <TextBlock Text="画质偏好" Style="{StaticResource BodyText}"/>
                    <TextBlock Text="控制远程设备时的码率与帧率档位" Style="{StaticResource CaptionText}"/>
                  </StackPanel>
                  <ComboBox x:Name="QualityBox" Grid.Column="1" Width="150" SelectedIndex="1">
                    <ComboBoxItem Content="智能码率"/>
                    <ComboBoxItem Content="流畅 8 Mbps"/>
                    <ComboBoxItem Content="均衡 14 Mbps"/>
                    <ComboBoxItem Content="高清 30 Mbps"/>
                  </ComboBox>
                </Grid>
              </Border>
              <Border Style="{StaticResource SettingRowBorder}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="2">
                    <TextBlock Text="显示性能 HUD" Style="{StaticResource BodyText}"/>
                    <TextBlock Text="会话中显示帧率、码率与延迟" Style="{StaticResource CaptionText}"/>
                  </StackPanel>
                  <ToggleSwitch x:Name="HudToggle" Grid.Column="1" OnContent="" OffContent="" Margin="0"/>
                </Grid>
              </Border>
              <Border Style="{StaticResource SettingRowBorder}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="2">
                    <TextBlock Text="默认开启加密连接" Style="{StaticResource BodyText}"/>
                    <TextBlock Text="会话建立时优先协商 mTLS 端到端加密" Style="{StaticResource CaptionText}"/>
                  </StackPanel>
                  <ToggleSwitch x:Name="EncryptToggle" Grid.Column="1" OnContent="" OffContent="" Margin="0"/>
                </Grid>
              </Border>
              <TextBlock Text="关于" Style="{StaticResource CaptionText}" Margin="0,10,0,4"/>
              <Border Style="{StaticResource SettingRowBorder}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="2">
                    <TextBlock Text="RabbitControl" Style="{StaticResource BodyText}"/>
                    <TextBlock Text="低延迟远程桌面控制系统" Style="{StaticResource CaptionText}"/>
                  </StackPanel>
                  <TextBlock x:Name="VersionText" Grid.Column="1" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                </Grid>
              </Border>
            </StackPanel>

            <StackPanel x:Name="PanelSecurity" Spacing="10" Visibility="Collapsed">
              <TextBlock Text="会话安全" Style="{StaticResource CaptionText}" Margin="0,4"/>
              <Border Style="{StaticResource SettingRowBorder}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="2">
                    <TextBlock Text="断开后锁定远程屏幕" Style="{StaticResource BodyText}"/>
                    <TextBlock Text="主动断开被控会话时自动锁定对方屏幕" Style="{StaticResource CaptionText}"/>
                  </StackPanel>
                  <ToggleSwitch x:Name="LockOnExitToggle" Grid.Column="1" OnContent="" OffContent="" Margin="0"/>
                </Grid>
              </Border>
              <Border Style="{StaticResource SettingRowBorder}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="2">
                    <TextBlock Text="被控验证方式" Style="{StaticResource BodyText}"/>
                    <TextBlock Text="临时验证码（每次远控结束轮换）· 自定义密码 · 密码通过自动接受" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <Button x:Name="HostVerifyButton" Grid.Column="1" Content="接通后可用" Style="{StaticResource SecondaryButton}" IsEnabled="False"/>
                </Grid>
              </Border>
            </StackPanel>

            <StackPanel x:Name="PanelNetwork" Spacing="10" Visibility="Collapsed">
              <TextBlock Text="服务器" Style="{StaticResource CaptionText}" Margin="0,4"/>
              <Border Style="{StaticResource SettingRowBorder}">
                <StackPanel Spacing="10">
                  <StackPanel Spacing="2">
                    <TextBlock Text="服务器地址" Style="{StaticResource BodyText}"/>
                    <TextBlock Text="仅填主机名时使用 HTTPS 与 21118 端口；本机调试支持 http://loopback" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NetworkOrigin" Height="36" VerticalContentAlignment="Center"/>
                    <Button x:Name="ProbeServer" Grid.Column="1" Content="探测并保存" Style="{StaticResource PrimaryButton}" Height="36"/>
                  </Grid>
                  <TextBlock x:Name="NetworkError" Style="{StaticResource CaptionText}" Foreground="{ThemeResource DangerBrush}" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
              <TextBlock x:Name="CurrentServerCaption" Style="{StaticResource CaptionText}" Margin="0,2"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- 会话（M2：主窗口内嵌过渡视图；M3.6 拆独立窗口） -->
      <Grid x:Name="SessionPage" Visibility="Collapsed" Background="#101922">
        <Grid.RowDefinitions>
          <RowDefinition Height="44"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1" Background="#141D27">
          <Grid Margin="12,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <TextBlock x:Name="SessionStatus" Text="正在连接…" Style="{StaticResource BodyText}" Foreground="#D8E4FF" VerticalAlignment="Center" MaxWidth="380" TextTrimming="CharacterEllipsis"/>
              <Border Background="#1E2B3C" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                <TextBlock x:Name="SessionBackend" Text="" FontSize="11" Foreground="#8FB0FF"/>
              </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" VerticalAlignment="Center">
              <Button x:Name="SessionReconnect" Content="重新连接" Style="{StaticResource SecondaryButton}" IsEnabled="False"/>
              <Button x:Name="SessionDisconnect" Style="{StaticResource PrimaryButton}" Height="32">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xED1C;" FontSize="13"/>
                  <TextBlock Text="断开" Style="{StaticResource BodyText}" Foreground="{ThemeResource TextOnPrimaryBrush}"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </Border>
        <Grid Grid.Row="1" x:Name="SessionStage">
          <SwapChainPanel x:Name="SessionPanel"/>
          <StackPanel x:Name="SessionOverlay" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" IsHitTestVisible="False">
            <ProgressRing x:Name="SessionSpinner" IsActive="True" Width="42" Height="42"/>
            <TextBlock x:Name="SessionOverlayText" Text="" Foreground="#C5D4E8" FontSize="15" HorizontalAlignment="Center"/>
          </StackPanel>
          <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="10" Background="#CC141D27" CornerRadius="6" Padding="10,6" IsHitTestVisible="False">
            <TextBlock x:Name="SessionHud" Text="" FontFamily="Consolas" FontSize="12" Foreground="#9FE0B3"/>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Grid>

  <!-- ===== 登录浮层（未登录时覆盖全窗口） ===== -->
  <Grid x:Name="LoginOverlay" Grid.Row="1" Visibility="Visible">
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EAF4FF" Offset="0"/>
        <GradientStop Color="#F5F0FF" Offset="1"/>
      </LinearGradientBrush>
    </Grid.Background>
    <Grid>
      <ScrollViewer x:Name="LoginView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxWidth="380" VerticalAlignment="Center" HorizontalContentAlignment="Stretch">
        <StackPanel Margin="20,20">
          <!-- 品牌 logo 区域 -->
          <StackPanel HorizontalAlignment="Center" Spacing="0" Margin="0,0,0,32">
            <Grid Width="56" Height="56" HorizontalAlignment="Center" Margin="0,0,0,12">
              <Border CornerRadius="14" Background="{ThemeResource PrimaryBrush}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                  <Ellipse Width="16" Height="12" Fill="White" Margin="0,4,0,0"/>
                  <Ellipse Width="8" Height="10" Fill="White" Margin="0,-2,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
              </Border>
            </Grid>
            <TextBlock Text="RabbitControl" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="远程桌面 · 账号登录" HorizontalAlignment="Center" Foreground="{ThemeResource TextTertiaryBrush}" FontSize="13" Margin="0,6,0,0"/>
          </StackPanel>
          <!-- 表单卡片 -->
          <Border Background="White" CornerRadius="14" Padding="20,22" BorderBrush="#E8E8F0" BorderThickness="1">
            <StackPanel Spacing="0">
              <TextBlock Text="账号邮箱" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="Email" AutomationProperties.Name="账号邮箱" PlaceholderText="请输入邮箱地址"
                       Background="#F8F9FB" BorderBrush="Transparent" CornerRadius="8"
                       Padding="12,10" Margin="0,6,0,14" FontSize="14" InputScope="EmailSmtpAddress"/>
              <TextBlock Text="密码" Style="{StaticResource FieldLabel}"/>
              <PasswordBox x:Name="Password" AutomationProperties.Name="密码" PlaceholderText="请输入密码"
                           Background="#F8F9FB" BorderBrush="Transparent" CornerRadius="8"
                           Padding="12,10" Margin="0,6,0,0" FontSize="14"/>
              <TextBlock x:Name="LoginError" Foreground="{ThemeResource DangerBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/>
              <Button x:Name="SignIn" Content="登录" Style="{StaticResource PrimaryButton}" Height="42" Margin="0,16,0,0"
                      HorizontalAlignment="Stretch"/>
            </StackPanel>
          </Border>
          <!-- 底部服务器信息 -->
          <Grid Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE968;" FontSize="13" Foreground="{ThemeResource TextTertiaryBrush}"/>
              <TextBlock x:Name="ServerCaption" MaxWidth="220" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{ThemeResource TextTertiaryBrush}"/>
            </StackPanel>
            <Button x:Name="ServerLink" HorizontalAlignment="Right" Content="服务器设置" Style="{StaticResource LinkButton}"/>
          </Grid>
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer x:Name="ServerSettingsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxWidth="380" VerticalAlignment="Center" HorizontalContentAlignment="Stretch">
        <StackPanel Margin="20,20">
          <Button x:Name="BackToLogin" Content="‹  返回登录" Style="{StaticResource LinkButton}" Margin="-8,0,0,18"/>
          <Border Background="White" CornerRadius="14" Padding="20,22" BorderBrush="#E8E8F0" BorderThickness="1">
            <StackPanel Spacing="0">
              <TextBlock Text="服务器设置" Style="{StaticResource SubtitleText}"/>
              <TextBlock Text="连接时将自动探测服务器并校验 Root CA 证书。" FontSize="13" Foreground="{ThemeResource TextTertiaryBrush}" Margin="0,8,0,20" TextWrapping="Wrap"/>
              <TextBlock Text="服务器地址" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="Origin" AutomationProperties.Name="服务器地址" PlaceholderText="https://主机:端口" FontSize="14"
                       Background="#F8F9FB" BorderBrush="Transparent" CornerRadius="8" Padding="12,10" Margin="0,6,0,6"/>
              <TextBlock Text="仅填主机名时使用 HTTPS 和端口 21118，也可输入完整地址。本机调试支持 HTTP。" FontSize="12" Foreground="{ThemeResource TextTertiaryBrush}" TextWrapping="Wrap"/>
              <TextBlock x:Name="SettingsError" Foreground="{ThemeResource DangerBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
              <Button x:Name="SaveServer" Content="保存地址" Style="{StaticResource PrimaryButton}" Height="42" Margin="0,16,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Grid>
