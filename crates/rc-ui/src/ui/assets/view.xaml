<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      RequestedTheme="Light" x:Name="RootLayout" Background="{ThemeResource SidebarBackgroundBrush}">
  <Grid.RowDefinitions>
    <RowDefinition Height="40"/>
    <RowDefinition Height="*"/>
  </Grid.RowDefinitions>
  <Grid.Resources>
    <!-- 更新弹窗「正在检查」的三点脉冲（由代码 Begin / Stop，与会话窗口连接中的动效同款） -->
    <Storyboard x:Name="UpdateSpinnerPulse">
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="UpdateDot1" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.3"/>
        <SplineDoubleKeyFrame KeyTime="0:0:0.18" Value="1"/>
        <SplineDoubleKeyFrame KeyTime="0:0:0.5" Value="0.3"/>
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="UpdateDot2" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.14" RepeatBehavior="Forever">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.3"/>
        <SplineDoubleKeyFrame KeyTime="0:0:0.18" Value="1"/>
        <SplineDoubleKeyFrame KeyTime="0:0:0.5" Value="0.3"/>
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="UpdateDot3" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.28" RepeatBehavior="Forever">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.3"/>
        <SplineDoubleKeyFrame KeyTime="0:0:0.18" Value="1"/>
        <SplineDoubleKeyFrame KeyTime="0:0:0.5" Value="0.3"/>
      </DoubleAnimationUsingKeyFrames>
    </Storyboard>
  </Grid.Resources>

  <!-- ===== 自绘标题栏（登录浮层覆盖时隐藏）：左边品牌；右边「更多 / 账号 / 新版本提醒 | 最小化 / 关闭」 ===== -->
  <Grid>
    <Border x:Name="DragRegion" Background="Transparent"/>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0" Spacing="8" IsHitTestVisible="False">
      <Image x:Name="TitleLogo" Width="22" Height="22" Stretch="Uniform"/>
      <TextBlock x:Name="AppTitle" Text="RabbitControl" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0">
      <Button x:Name="TitleMore" Style="{StaticResource CaptionIconButton}" AutomationProperties.Name="更多" ToolTipService.ToolTip="更多">
        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE700;" FontSize="16"/>
        <Button.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedRight">
            <MenuFlyout.MenuFlyoutPresenterStyle>
              <Style TargetType="MenuFlyoutPresenter">
                <Setter Property="MinWidth" Value="176"/>
                <Setter Property="Padding" Value="4,6"/>
              </Style>
            </MenuFlyout.MenuFlyoutPresenterStyle>
            <MenuFlyoutItem x:Name="MenuSecurityLock" Text="安全锁定">
              <MenuFlyoutItem.Icon>
                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72E;"/>
              </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="MenuFeedback" Text="提交反馈">
              <MenuFlyoutItem.Icon>
                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8BD;"/>
              </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="MenuCheckUpdate" Text="检查更新">
              <MenuFlyoutItem.Icon>
                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE895;"/>
              </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator/>
            <MenuFlyoutItem x:Name="MenuAbout" Text="关于">
              <MenuFlyoutItem.Icon>
                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE946;"/>
              </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
          </MenuFlyout>
        </Button.Flyout>
      </Button>
      <Button x:Name="TitleAccount" Style="{StaticResource CaptionIconButton}" AutomationProperties.Name="账号" ToolTipService.ToolTip="账号">
        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE77B;" FontSize="16"/>
      </Button>
      <!-- 新版本提醒：有新版本时才出现，点了打开更新弹窗 -->
      <Button x:Name="TitleUpdate" Style="{StaticResource CaptionIconButton}" AutomationProperties.Name="有新版本可用" ToolTipService.ToolTip="发现新版本，点击查看" Visibility="Collapsed">
        <Grid Width="20" Height="20">
          <Ellipse Fill="#22C55E"/>
          <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE74A;" FontSize="11" Foreground="White"/>
        </Grid>
      </Button>
      <Rectangle x:Name="TitleDivider" Width="1" Height="18" Fill="#D8DEE4" VerticalAlignment="Center" Margin="10,0,8,0"/>
      <Button x:Name="Minimize" AutomationProperties.Name="最小化" Content="&#xE921;" Style="{StaticResource CaptionButton}"/>
      <Button x:Name="CloseWindow" AutomationProperties.Name="关闭" Content="&#xE8BB;" Style="{StaticResource CaptionCloseButton}"/>
    </StackPanel>
  </Grid>

  <!-- ===== 已登录主壳：侧栏 + 内容区 ===== -->
  <Grid x:Name="MainShell" Grid.Row="1" Visibility="Collapsed">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="216"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- 侧栏（对齐 UU）：悬停浅灰；选中 = 灰底 + 紧贴窗口左缘的蓝色竖条，文字始终深色 -->
    <Border Background="{ThemeResource SidebarBackgroundBrush}" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,1,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="10"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1" Spacing="2">
          <ToggleButton x:Name="NavDevices" Style="{StaticResource NavItem}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <FontIcon x:Name="NavDevicesIcon" FontFamily="Segoe MDL2 Assets" Glyph="&#xE7F4;" FontSize="16" VerticalAlignment="Center"/>
              <TextBlock Text="我的设备" VerticalAlignment="Center"/>
            </StackPanel>
          </ToggleButton>
          <ToggleButton x:Name="NavAssist" Style="{StaticResource NavItem}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <FontIcon x:Name="NavAssistIcon" FontFamily="Segoe MDL2 Assets" Glyph="&#xE720;" FontSize="16" VerticalAlignment="Center"/>
              <TextBlock Text="远程协助" VerticalAlignment="Center"/>
            </StackPanel>
          </ToggleButton>
          <ToggleButton x:Name="NavFavorites" Style="{StaticResource NavItem}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <FontIcon x:Name="NavFavoritesIcon" FontFamily="Segoe MDL2 Assets" Glyph="&#xE735;" FontSize="16" VerticalAlignment="Center"/>
              <TextBlock Text="收藏设备" VerticalAlignment="Center"/>
            </StackPanel>
          </ToggleButton>
          <ToggleButton x:Name="NavSettings" Style="{StaticResource NavItem}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <FontIcon x:Name="NavSettingsIcon" FontFamily="Segoe MDL2 Assets" Glyph="&#xE713;" FontSize="16" VerticalAlignment="Center"/>
              <TextBlock Text="设置" VerticalAlignment="Center"/>
            </StackPanel>
          </ToggleButton>
        </StackPanel>
        <!-- 页脚只放服务连接状态；账号与退出登录在右上角的账号弹窗里 -->
        <Border Grid.Row="3" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,1,0,0" Padding="14,12">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{ThemeResource OfflineBrush}" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Text="信令连接中…" Style="{StaticResource CaptionText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- 内容区：比侧栏更浅的底；顶上留给安全锁定横幅（没锁定时收起，不占高度） -->
    <Grid Grid.Column="1" Background="{ThemeResource PageBackgroundBrush}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- 安全锁定横幅：锁定期间每个页面顶上都有一条，设置类控件全部禁用 -->
      <Border x:Name="LockBanner" CornerRadius="10" Margin="24,16,24,0" Padding="14,8" Background="{ThemeResource AccentSoftBrush}" BorderBrush="#CFDDFF" BorderThickness="1" Visibility="Collapsed">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72E;" FontSize="15" Foreground="{ThemeResource AccentStrongBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="客户端已安全锁定" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="锁定期间不能修改设置、也不能退出客户端；发起远程控制不受影响" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
          </StackPanel>
          <Button x:Name="LockBannerUnlock" Grid.Column="1" Content="立即解锁" Style="{StaticResource OutlineButton}" Height="30" VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <!-- 我的设备：只有列表。本机的验证码 / 开关属于「远程协助」页（与 UU / ToDesk 一致） -->
      <Grid x:Name="DevicesPage" Grid.Row="1" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- 页头：标题 + 状态；右边搜索与刷新（服务器地址只在登录页与设置页出现，首页不放） -->
        <Grid Margin="24,18,24,14">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock Text="我的设备" Style="{StaticResource DisplayText}"/>
            <TextBlock x:Name="DevicesStatus" VerticalAlignment="Center" Style="{StaticResource CaptionText}"
                       Foreground="{ThemeResource PrimaryBrush}" MaxWidth="380" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
            <!-- 文本框自己就是这个药丸（图标叠在左侧留白上）：聚焦描边沿圆角画一圈，清除按钮也落在框内 -->
            <Grid Width="220">
              <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE721;" FontSize="13" Foreground="{ThemeResource TextTertiaryBrush}"
                        VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False"/>
              <TextBox x:Name="DeviceSearch" Style="{StaticResource SoftTextBox}" PlaceholderText="搜索设备名或 ID" FontSize="13"
                       Padding="34,0,8,0" AutomationProperties.Name="搜索设备"/>
            </Grid>
            <Button x:Name="RefreshDevices" Style="{StaticResource LightGhostIconButton}" AutomationProperties.Name="刷新设备列表" ToolTipService.ToolTip="刷新">
              <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72C;" FontSize="15"/>
            </Button>
          </StackPanel>
        </Grid>

        <!-- 被控中横幅（M5：被控会话进行中展开） -->
        <Border x:Name="HostBanner" Grid.Row="1" Margin="24,0,24,12" CornerRadius="12" Background="{ThemeResource BannerGradient}" Padding="20,14" Visibility="Collapsed">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="14">
              <Ellipse Width="8" Height="8" Fill="{ThemeResource TextOnPrimaryBrush}" VerticalAlignment="Center"/>
              <TextBlock Text="本机被控中" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextOnPrimaryBrush}" VerticalAlignment="Center"/>
              <TextBlock x:Name="BannerTimer" Text="00:00:00" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextOnPrimaryBrush}" VerticalAlignment="Center" FontFamily="Consolas"/>
              <TextBlock x:Name="BannerSub" Text="" FontSize="12" Foreground="#D8E4FF" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <Button x:Name="BannerDisconnect" Content="断开所有远程" Style="{StaticResource SecondaryButton}" Height="32" Background="#33FFFFFF" BorderBrush="#55FFFFFF" Foreground="{ThemeResource TextOnPrimaryBrush}"/>
            </StackPanel>
          </Grid>
        </Border>

        <Grid Grid.Row="2">
          <ScrollViewer Padding="24,0,24,16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="DeviceListHost" Spacing="10"/>
          </ScrollViewer>
          <StackPanel x:Name="DevicesEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" IsHitTestVisible="False">
            <Border Width="64" Height="64" CornerRadius="18" Background="{ThemeResource AccentSoftBrush}" HorizontalAlignment="Center">
              <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7F4;" FontSize="26" Foreground="{ThemeResource AccentStrongBrush}"/>
            </Border>
            <TextBlock x:Name="DevicesEmptyTitle" Text="账号下暂无设备" Style="{StaticResource SubtitleText}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            <TextBlock x:Name="DevicesEmptyHint" Text="在本机或其他设备登录后，设备会出现在这里" Style="{StaticResource CaptionText}" HorizontalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Grid>

      <!-- 远程协助（对齐 UU）：「本设备」卡片放设备 ID / 验证方式 / 复制并分享；「远控伙伴设备」卡片放伙伴 ID 与连接 -->
      <Grid x:Name="AssistPage" Grid.Row="1" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="远程协助" Style="{StaticResource DisplayText}" Margin="24,18,24,14"/>
        <ScrollViewer Grid.Row="1" Padding="24,0,24,16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="16">

            <!-- 本设备：标题行（总开关在右）+ 分隔线 + 设备 ID / 验证方式 / 复制并分享 -->
            <Border Style="{StaticResource SectionCardBorder}">
              <StackPanel>
                <Grid Padding="20,14" ColumnSpacing="12">
                  <TextBlock Text="本设备" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                    <TextBlock Text="允许他人远程协助" FontSize="14" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <ToggleSwitch x:Name="HostSwitch" OnContent="" OffContent="" Margin="0" VerticalAlignment="Center"/>
                  </StackPanel>
                </Grid>
                <Border Height="1" Background="{ThemeResource DividerBrush}"/>
                <Grid Padding="20,16" ColumnSpacing="32">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="本设备ID" Style="{StaticResource CaptionText}"/>
                    <TextBlock x:Name="LocalIdText" Text="··· ··· ···" FontSize="30" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center" MinWidth="236">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock Text="验证方式" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                      <ComboBox x:Name="HostVerifyMode" Width="168" SelectedIndex="0" Style="{StaticResource SoftComboBox}" FontSize="13">
                        <ComboBoxItem Content="仅使用临时验证码"/>
                        <ComboBoxItem Content="仅使用自定义密码"/>
                      </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="2">
                      <!-- 验证码默认打码（眼睛图标切换显示）；自定义密码只显示打码，要去设置里改 -->
                      <TextBlock x:Name="HostCode" Text="开启后显示" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" MinWidth="120"/>
                      <Button x:Name="AssistCodeEye" Style="{StaticResource LightGhostIconButton}" AutomationProperties.Name="显示或隐藏验证码" ToolTipService.ToolTip="显示 / 隐藏">
                        <FontIcon x:Name="AssistCodeEyeIcon" FontFamily="Segoe MDL2 Assets" Glyph="&#xE890;" FontSize="14"/>
                      </Button>
                      <Button x:Name="AssistRotateCode" Style="{StaticResource LightGhostIconButton}" AutomationProperties.Name="刷新临时验证码" ToolTipService.ToolTip="换一个临时验证码">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72C;" FontSize="14"/>
                      </Button>
                      <Button x:Name="AssistVerifySettings" Style="{StaticResource LightGhostIconButton}" AutomationProperties.Name="验证设置" ToolTipService.ToolTip="修改自定义密码" Visibility="Collapsed">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE713;" FontSize="14"/>
                      </Button>
                    </StackPanel>
                    <TextBlock x:Name="HostCodeHint" Text="每次远程控制结束后自动刷新" Style="{StaticResource CaptionText}"/>
                  </StackPanel>
                  <Button x:Name="CopyIdButton" Grid.Column="3" Content="复制并分享" Style="{StaticResource OutlineButton}" MinWidth="128" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
                <TextBlock x:Name="HostError" Text="" Foreground="{ThemeResource DangerBrush}" FontSize="12" TextWrapping="Wrap" Margin="20,0,20,12" Visibility="Collapsed"/>
              </StackPanel>
            </Border>

            <!-- 远控伙伴设备：标题 + 说明 + 分隔线 + 伙伴 ID 与连接 -->
            <Border Style="{StaticResource SectionCardBorder}">
              <StackPanel>
                <StackPanel Padding="20,14" Spacing="4">
                  <TextBlock Text="远控伙伴设备" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                  <TextBlock Text="通过伙伴设备的设备 ID 发起远程控制" Style="{StaticResource CaptionText}"/>
                </StackPanel>
                <Border Height="1" Background="{ThemeResource DividerBrush}"/>
                <StackPanel Padding="20,16" Spacing="10">
                  <TextBlock Text="伙伴的设备ID" Style="{StaticResource CaptionText}"/>
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBox x:Name="PeerCodeBox" Style="{StaticResource SoftTextBox}" PlaceholderText="请输入设备 ID" MaxLength="11" Width="240" Height="40" FontSize="15" FontFamily="Consolas"/>
                    <Button x:Name="ConnectPeerButton" Content="连接" Style="{StaticResource PrimaryButton}" Width="128" Height="40" IsEnabled="False"/>
                    <Button x:Name="PeerAdvancedButton" Content="高级选项" Style="{StaticResource LinkButton}" Height="40"/>
                  </StackPanel>
                  <StackPanel x:Name="PeerAdvancedRow" Orientation="Horizontal" Spacing="16" Visibility="Collapsed">
                    <PasswordBox x:Name="PeerPasswordBox" Style="{StaticResource SoftPasswordBox}" PlaceholderText="伙伴设备的访问密码（对方设了才填）" Width="260"/>
                    <CheckBox x:Name="WatchOnlyCheck" Content="仅观看，不控制" VerticalAlignment="Center"/>
                  </StackPanel>
                  <TextBlock x:Name="AssistError" Style="{StaticResource CaptionText}" Foreground="{ThemeResource DangerBrush}" TextWrapping="Wrap"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- 最近 / 收藏 -->
            <Border Style="{StaticResource CardBorder}">
              <StackPanel Spacing="12">
                <Grid>
                  <Border Background="{ThemeResource FieldFillBrush}" CornerRadius="8" Padding="2" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                      <ToggleButton x:Name="HistoryTabRecent" Content="最近连接" Style="{StaticResource SegmentTabLight}" IsChecked="True"/>
                      <ToggleButton x:Name="HistoryTabFav" Content="收藏" Style="{StaticResource SegmentTabLight}"/>
                    </StackPanel>
                  </Border>
                </Grid>
                <StackPanel x:Name="HistoryListHost" Spacing="8"/>
                <TextBlock x:Name="HistoryEmpty" Text="暂无记录" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" Margin="0,6"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

            <!-- 收藏设备 -->
      <Grid x:Name="FavoritesPage" Grid.Row="1" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="收藏设备" Style="{StaticResource DisplayText}" Margin="24,18,24,14"/>
        <Grid Grid.Row="1">
          <ScrollViewer Padding="24,0,24,16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="FavoritesListHost" Spacing="10"/>
          </ScrollViewer>
          <StackPanel x:Name="FavoritesEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" IsHitTestVisible="False">
            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE735;" FontSize="42" Foreground="{ThemeResource OfflineBrush}"/>
            <TextBlock Text="还没有收藏设备" Style="{StaticResource SubtitleText}" HorizontalAlignment="Center"/>
            <TextBlock Text="在设备列表的「⋯」菜单里收藏设备，它会出现在这里" Style="{StaticResource CaptionText}" HorizontalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Grid>

      <!-- 设置 -->
      <Grid x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="设置" Style="{StaticResource DisplayText}" Margin="24,18,24,12"/>
        <!-- 分段开关（与协助页的「最近连接 / 收藏」同一种）：选中项白底浮起 -->
        <Border Grid.Row="1" Background="{ThemeResource FieldFillBrush}" CornerRadius="8" Padding="2" HorizontalAlignment="Left" Margin="24,0,24,10">
          <StackPanel Orientation="Horizontal">
            <ToggleButton x:Name="TabGeneral" Content="常规" Style="{StaticResource SegmentTabLight}" IsChecked="True"/>
            <ToggleButton x:Name="TabSecurity" Content="安全" Style="{StaticResource SegmentTabLight}"/>
            <ToggleButton x:Name="TabNetwork" Content="网络" Style="{StaticResource SegmentTabLight}"/>
          </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="2" Padding="24,0,24,16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxWidth="720" HorizontalAlignment="Left">
          <StackPanel Spacing="4">

            <StackPanel x:Name="PanelGeneral" Spacing="10">
              <TextBlock Text="画质" Style="{StaticResource CaptionText}" Margin="0,4"/>
              <Border Style="{StaticResource SettingRowBorder}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="2">
                    <TextBlock Text="画质偏好" Style="{StaticResource BodyText}"/>
                    <TextBlock Text="控制远程设备时的码率与帧率档位" Style="{StaticResource CaptionText}"/>
                  </StackPanel>
                  <ComboBox x:Name="QualityBox" Grid.Column="1" Width="150" SelectedIndex="1" Style="{StaticResource SoftComboBox}">
                    <ComboBoxItem Content="智能码率"/>
                    <ComboBoxItem Content="流畅 8 Mbps"/>
                    <ComboBoxItem Content="均衡 14 Mbps"/>
                    <ComboBoxItem Content="高清 30 Mbps"/>
                  </ComboBox>
                </Grid>
              </Border>
              <Border Style="{StaticResource SettingRowBorder}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="2">
                    <TextBlock Text="显示性能 HUD" Style="{StaticResource BodyText}"/>
                    <TextBlock Text="会话中显示帧率、码率与延迟" Style="{StaticResource CaptionText}"/>
                  </StackPanel>
                  <ToggleSwitch x:Name="HudToggle" Grid.Column="1" OnContent="" OffContent="" Margin="0"/>
                </Grid>
              </Border>
              <Border Style="{StaticResource SettingRowBorder}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="2">
                    <TextBlock Text="开机自动启动（后台服务）" Style="{StaticResource BodyText}"/>
                    <TextBlock x:Name="AutoStartCaption" Text="注册系统服务实现开机自启与提权代理；开启时弹 UAC 授权" Style="{StaticResource CaptionText}"/>
                  </StackPanel>
                  <ToggleSwitch x:Name="AutoStartToggle" Grid.Column="1" OnContent="" OffContent="" Margin="0" IsEnabled="True"/>
                </Grid>
              </Border>
              <TextBlock Text="出站代理" Style="{StaticResource CaptionText}" Margin="0,10,0,4"/>
              <Border Style="{StaticResource SettingRowBorder}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="2">
                    <TextBlock Text="SOCKS5 / HTTP 代理" Style="{StaticResource BodyText}"/>
                    <TextBlock Text="填代理地址（如 socks5://127.0.0.1:1080），留空直连；REST/信令/中继自动走代理" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <TextBox x:Name="ProxyUrl" Style="{StaticResource SoftTextBox}" Width="180" Height="32" FontSize="12"
                             PlaceholderText="socks5://host:port"/>
                    <Button x:Name="ProxyApplyButton" Content="应用" Style="{StaticResource SecondaryButton}" Height="32"/>
                  </StackPanel>
                </Grid>
              </Border>
              <TextBlock x:Name="ProxyStatus" FontSize="12" Foreground="{ThemeResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="24,0,24,0"/>
              <TextBlock Text="更新" Style="{StaticResource CaptionText}" Margin="0,10,0,4"/>
              <Border Style="{StaticResource SettingRowBorder}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="2">
                    <TextBlock x:Name="UpdateStatus" Text="当前版本" Style="{StaticResource BodyText}"/>
                    <TextBlock Text="启动时自动检查 GitHub Releases 新版本" Style="{StaticResource CaptionText}"/>
                  </StackPanel>
                  <Button x:Name="CheckUpdateButton" Grid.Column="1" Content="检查更新" Style="{StaticResource SecondaryButton}" Height="32"/>
                </Grid>
              </Border>
              <TextBlock Text="关于" Style="{StaticResource CaptionText}" Margin="0,10,0,4"/>
              <Border Style="{StaticResource SettingRowBorder}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="2">
                    <TextBlock Text="RabbitControl" Style="{StaticResource BodyText}"/>
                    <TextBlock Text="低延迟远程桌面控制系统" Style="{StaticResource CaptionText}"/>
                  </StackPanel>
                  <TextBlock x:Name="VersionText" Grid.Column="1" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                </Grid>
              </Border>
            </StackPanel>

            <StackPanel x:Name="PanelSecurity" Spacing="10" Visibility="Collapsed">
              <TextBlock Text="会话安全" Style="{StaticResource CaptionText}" Margin="0,4"/>
              <Border Style="{StaticResource SettingRowBorder}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="2">
                    <TextBlock Text="默认开启加密连接 (mTLS)" Style="{StaticResource BodyText}"/>
                    <TextBlock Text="会话建立时优先协商 mTLS 端到端加密；需要本机设备证书" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <ToggleSwitch x:Name="EncryptToggle" Grid.Column="1" OnContent="" OffContent="" Margin="0"/>
                </Grid>
              </Border>
              <Border Style="{StaticResource SettingRowBorder}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="2">
                    <TextBlock Text="允许其他账号发起协助" Style="{StaticResource BodyText}"/>
                    <TextBlock Text="关闭后只有本账号下的设备能控制本机，其他账号的协助请求一律拒绝" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <ToggleSwitch x:Name="AssistToggle" Grid.Column="1" OnContent="" OffContent="" Margin="0"/>
                </Grid>
              </Border>
              <Border Style="{StaticResource SettingRowBorder}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="2">
                    <TextBlock Text="断开后锁定远程屏幕" Style="{StaticResource BodyText}"/>
                    <TextBlock Text="主动断开被控会话时自动锁定对方屏幕" Style="{StaticResource CaptionText}"/>
                  </StackPanel>
                  <ToggleSwitch x:Name="LockOnExitToggle" Grid.Column="1" OnContent="" OffContent="" Margin="0"/>
                </Grid>
              </Border>
              <Border Style="{StaticResource SettingRowBorder}">
                <StackPanel Spacing="10">
                  <StackPanel Spacing="2">
                    <TextBlock Text="被控验证方式" Style="{StaticResource BodyText}"/>
                    <TextBlock Text="在「远程协助」页的本设备卡片上切换临时验证码 / 自定义密码。临时验证码每次远控结束自动刷新；自定义密码验证通过后自动接受连接" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <StackPanel x:Name="HostVerifyCustomPanel" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                    <PasswordBox x:Name="HostVerifyPassword" Style="{StaticResource SoftPasswordBox}" Width="240" PlaceholderText="自定义访问密码" AutomationProperties.Name="自定义访问密码"/>
                    <Button x:Name="HostVerifySaveButton" Content="保存密码" Style="{StaticResource SecondaryButton}" Height="36"/>
                  </StackPanel>
                  <Button x:Name="HostRotateCodeButton" Content="刷新临时验证码" Style="{StaticResource SecondaryButton}" Height="36" HorizontalAlignment="Left"/>
                </StackPanel>
              </Border>
              <TextBlock Text="客户端安全锁定" Style="{StaticResource CaptionText}" Margin="0,6,0,0"/>
              <Border Style="{StaticResource SettingRowBorder}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="2">
                    <TextBlock Text="安全密钥" Style="{StaticResource BodyText}"/>
                    <TextBlock x:Name="LockKeyStatus" Text="未设置。设置后可以从右上角「更多」一键锁定客户端" Style="{StaticResource CaptionText}" TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Left"/>
                  </StackPanel>
                  <Button x:Name="LockKeyButton" Grid.Column="1" Content="设置安全密钥" Style="{StaticResource SecondaryButton}" Height="36" VerticalAlignment="Center"/>
                </Grid>
              </Border>
              <Border Style="{StaticResource SettingRowBorder}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="2">
                    <TextBlock Text="远程协助本设备期间自动锁定" Style="{StaticResource BodyText}"/>
                    <TextBlock Text="有人正在控制这台机器时自动进入锁定，协助结束后自动解锁" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <ToggleSwitch x:Name="LockAutoAssistToggle" Grid.Column="1" OnContent="" OffContent="" Margin="0"/>
                </Grid>
              </Border>
              <Border Style="{StaticResource SettingRowBorder}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="2">
                    <TextBlock Text="启动客户端时自动锁定" Style="{StaticResource BodyText}"/>
                    <TextBlock Text="打开客户端就进入锁定状态，直到输入安全密钥" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <ToggleSwitch x:Name="LockAutoStartToggle" Grid.Column="1" OnContent="" OffContent="" Margin="0"/>
                </Grid>
              </Border>
              <Border Style="{StaticResource SettingRowBorder}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="2">
                    <TextBlock Text="本机 mTLS 设备证书" Style="{StaticResource BodyText}"/>
                    <TextBlock x:Name="CertStatusText" Text="未签发（请先登录）" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <Button x:Name="CertRenewButton" Grid.Column="1" Content="立即续签" Style="{StaticResource SecondaryButton}" Height="32"/>
                </Grid>
              </Border>
              <Border Style="{StaticResource SettingRowBorder}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="2">
                    <TextBlock Text="被远程协助时允许文件互传" Style="{StaticResource BodyText}"/>
                    <TextBlock Text="被控会话中允许对端通过工具通道传输文件" Style="{StaticResource CaptionText}"/>
                  </StackPanel>
                  <ToggleSwitch x:Name="FileTransferToggle" Grid.Column="1" OnContent="" OffContent="" Margin="0"/>
                </Grid>
              </Border>
              <TextBlock x:Name="SecurityStatus" FontSize="12" Foreground="{ThemeResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="24,0,24,0"/>
            </StackPanel>

            <StackPanel x:Name="PanelNetwork" Spacing="10" Visibility="Collapsed">
              <TextBlock Text="服务器" Style="{StaticResource CaptionText}" Margin="0,4"/>
              <Border Style="{StaticResource SettingRowBorder}">
                <StackPanel Spacing="10">
                  <StackPanel Spacing="2">
                    <TextBlock Text="服务器地址" Style="{StaticResource BodyText}"/>
                    <TextBlock Text="仅填主机名时使用 HTTPS 与 21118 端口；本机调试支持 http://loopback" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NetworkOrigin" Style="{StaticResource SoftTextBox}" Height="36"/>
                    <Button x:Name="ProbeServer" Grid.Column="1" Content="探测并保存" Style="{StaticResource PrimaryButton}" Height="36"/>
                  </Grid>
                  <TextBlock x:Name="NetworkError" Style="{StaticResource CaptionText}" Foreground="{ThemeResource DangerBrush}" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
              <TextBlock x:Name="CurrentServerCaption" Style="{StaticResource CaptionText}" Margin="0,2"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- M5 连接审批弹窗 -->
      <Grid x:Name="HostApprovalOverlay" Grid.Row="1" Visibility="Collapsed" Background="#88000000">
        <Border Width="420" Background="White" CornerRadius="12" Padding="22">
          <StackPanel Spacing="14">
            <TextBlock Text="远程连接请求" Style="{StaticResource TitleText}"/>
            <TextBlock x:Name="ApprovalPeer" Text="" Style="{StaticResource BodyText}" TextWrapping="Wrap"/>
            <TextBlock x:Name="ApprovalDetail" Text="" FontSize="12" Foreground="{ThemeResource TextTertiaryBrush}" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,6,0,0">
              <Button x:Name="HostReject" Content="拒绝" Style="{StaticResource SecondaryButton}" Height="36" Width="96"/>
              <Button x:Name="HostApprove" Content="接受" Style="{StaticResource PrimaryButton}" Height="36" Width="96"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
      <!-- 重命名输入浮层（prompt stub 修复：原返回 None 导致重命名不可用） -->
      <Grid x:Name="RenamePromptOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#88000000">
        <Border Width="360" Background="White" CornerRadius="10" Padding="18">
          <StackPanel Spacing="10">
            <TextBlock Text="重命名设备" Style="{StaticResource SubtitleText}"/>
            <TextBox x:Name="RenamePromptInput" Style="{StaticResource SoftTextBox}" Height="36"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
              <Button x:Name="RenamePromptCancel" Content="取消" Style="{StaticResource SecondaryButton}" Height="32"/>
              <Button x:Name="RenamePromptOk" Content="确定" Style="{StaticResource PrimaryButton}" Height="32" Width="90"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
      <!-- 会话 UI 已迁移至独立窗口（ui/assets/session_window.xaml，M3.6） -->

    </Grid>
  </Grid>

  <!-- ===== 模态框（账号 / 修改密码 / 更新 / 安全锁定 / 关于）：一张卡片，内容面板切换 ===== -->
  <Grid x:Name="ModalOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#66000000">
    <Border Width="440" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="16">
        <Grid>
          <TextBlock x:Name="ModalTitle" Text="" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" MaxWidth="370" TextTrimming="CharacterEllipsis"/>
          <Button x:Name="ModalClose" Style="{StaticResource LightGhostIconButton}" AutomationProperties.Name="关闭" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0">
            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE711;" FontSize="14"/>
          </Button>
        </Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="480">
          <Grid>
            <!-- 账号 -->
            <StackPanel x:Name="ModalAccount" Spacing="14" Visibility="Collapsed">
              <StackPanel Orientation="Horizontal" Spacing="14">
                <Border Width="48" Height="48" CornerRadius="24" Background="{ThemeResource AccentSoftBrush}">
                  <TextBlock x:Name="AccountAvatar" Text="?" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource AccentStrongBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                  <TextBlock x:Name="AccountEmail" Text="" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" MaxWidth="310" TextTrimming="CharacterEllipsis"/>
                  <TextBlock x:Name="AccountMeta" Text="" Style="{StaticResource CaptionText}" MaxWidth="310" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </StackPanel>
              <Border Height="1" Background="{ThemeResource DividerBrush}"/>
              <TextBlock x:Name="AccountDevice" Text="" FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="AccountChangePassword" Content="修改密码" Style="{StaticResource SecondaryButton}"/>
                <Button x:Name="LogoutButton" Content="退出登录" Style="{StaticResource DangerLinkButton}" Height="36" Padding="12,0"/>
              </StackPanel>
            </StackPanel>

            <!-- 修改密码 -->
            <StackPanel x:Name="ModalChangePassword" Spacing="10" Visibility="Collapsed">
              <TextBlock Text="修改后，其它设备上的登录会失效，需要用新密码重新登录" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
              <TextBlock Text="当前密码" Style="{StaticResource FieldLabel}"/>
              <PasswordBox x:Name="PasswordCurrent" Style="{StaticResource SoftPasswordBox}" AutomationProperties.Name="当前密码"/>
              <TextBlock Text="新密码" Style="{StaticResource FieldLabel}"/>
              <PasswordBox x:Name="PasswordNew" Style="{StaticResource SoftPasswordBox}" AutomationProperties.Name="新密码"/>
              <TextBlock Text="确认新密码" Style="{StaticResource FieldLabel}"/>
              <PasswordBox x:Name="PasswordNewConfirm" Style="{StaticResource SoftPasswordBox}" AutomationProperties.Name="确认新密码"/>
              <TextBlock x:Name="PasswordChangeError" Text="" FontSize="12" Foreground="{ThemeResource DangerBrush}" TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
                <Button x:Name="PasswordChangeCancel" Content="取消" Style="{StaticResource SecondaryButton}"/>
                <Button x:Name="PasswordChangeSubmit" Content="确认修改" Style="{StaticResource PrimaryButton}" Width="110"/>
              </StackPanel>
            </StackPanel>

            <!-- 更新 -->
            <StackPanel x:Name="ModalUpdate" Spacing="14" Visibility="Collapsed">
              <StackPanel x:Name="UpdateFound" Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Border Width="40" Height="40" CornerRadius="20" Background="#E6F7EC">
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE74A;" FontSize="16" Foreground="{ThemeResource SuccessBrush}"/>
                  </Border>
                  <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="UpdateVersion" Text="发现新版本" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="UpdateDate" Text="" Style="{StaticResource CaptionText}"/>
                  </StackPanel>
                </StackPanel>
                <Border Background="{ThemeResource PageBackgroundBrush}" CornerRadius="8" Padding="12" MaxHeight="220">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="UpdateNotes" Text="" FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                  </ScrollViewer>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                  <Button x:Name="UpdateOpenPage" Content="查看发布页面" Style="{StaticResource SecondaryButton}"/>
                  <Button x:Name="UpdateDownload" Content="立即更新" Style="{StaticResource PrimaryButton}" Width="120"/>
                </StackPanel>
              </StackPanel>
              <StackPanel x:Name="UpdateMessage" Orientation="Horizontal" Spacing="10" Visibility="Collapsed">
                <Grid x:Name="UpdateSpinner" Width="22" Height="16" VerticalAlignment="Center">
                  <Ellipse x:Name="UpdateDot1" Width="6" Height="6" Fill="{ThemeResource PrimaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" Opacity="0.3"/>
                  <Ellipse x:Name="UpdateDot2" Width="6" Height="6" Fill="{ThemeResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.3"/>
                  <Ellipse x:Name="UpdateDot3" Width="6" Height="6" Fill="{ThemeResource PrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,1,0" Opacity="0.3"/>
                </Grid>
                <TextBlock x:Name="UpdateStatusLine" Text="" FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="350"/>
              </StackPanel>
              <Button x:Name="UpdateRetry" Content="重试" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Visibility="Collapsed"/>
              <Border Height="1" Background="{ThemeResource DividerBrush}"/>
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="自动检查更新" Style="{StaticResource BodyText}"/>
                  <TextBlock Text="启动时后台检查，有新版本时右上角提醒" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                </StackPanel>
                <ToggleSwitch x:Name="UpdateAutoCheck" Grid.Column="1" OnContent="" OffContent="" Margin="0"/>
              </Grid>
            </StackPanel>

            <!-- 安全锁定：设置 / 修改密钥 -->
            <StackPanel x:Name="ModalLockSetup" Spacing="10" Visibility="Collapsed">
              <TextBlock Text="设置后可以从右上角「更多」一键锁定客户端：锁定期间不能修改设置、也不能退出客户端，直到输入密钥解锁。密钥保存后不可查看，请妥善保管。" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
              <TextBlock Text="安全密钥（8–16 位）" Style="{StaticResource FieldLabel}"/>
              <PasswordBox x:Name="LockKeyInput" Style="{StaticResource SoftPasswordBox}" AutomationProperties.Name="安全密钥" MaxLength="32"/>
              <TextBlock Text="确认安全密钥" Style="{StaticResource FieldLabel}"/>
              <PasswordBox x:Name="LockKeyConfirm" Style="{StaticResource SoftPasswordBox}" AutomationProperties.Name="确认安全密钥" MaxLength="32"/>
              <TextBlock x:Name="LockSetupError" Text="" FontSize="12" Foreground="{ThemeResource DangerBrush}" TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
                <Button x:Name="LockSetupCancel" Content="取消" Style="{StaticResource SecondaryButton}"/>
                <Button x:Name="LockSetupSubmit" Content="保存并锁定" Style="{StaticResource PrimaryButton}" Width="120"/>
              </StackPanel>
            </StackPanel>

            <!-- 安全锁定：解锁 -->
            <StackPanel x:Name="ModalLockUnlock" Spacing="10" Visibility="Collapsed">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Width="40" Height="40" CornerRadius="20" Background="{ThemeResource AccentSoftBrush}">
                  <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72E;" FontSize="16" Foreground="{ThemeResource AccentStrongBrush}"/>
                </Border>
                <TextBlock Text="验证码、验证方式、被控开关等设置在锁定期间不能修改，也不能退出客户端；发起远程控制不受影响。输入安全密钥解锁。" Style="{StaticResource CaptionText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock Text="安全密钥" Style="{StaticResource FieldLabel}"/>
              <PasswordBox x:Name="LockUnlockInput" Style="{StaticResource SoftPasswordBox}" AutomationProperties.Name="安全密钥" MaxLength="32"/>
              <TextBlock x:Name="LockUnlockError" Text="" FontSize="12" Foreground="{ThemeResource DangerBrush}" TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
                <Button x:Name="LockRecoverLogout" Content="忘记密钥？退出登录" Style="{StaticResource DangerLinkButton}" Height="36" Padding="12,0"/>
                <Button x:Name="LockUnlockSubmit" Content="确定解锁" Style="{StaticResource PrimaryButton}" Width="120"/>
              </StackPanel>
            </StackPanel>

            <!-- 关于 -->
            <StackPanel x:Name="ModalAbout" Spacing="12" Visibility="Collapsed">
              <StackPanel Orientation="Horizontal" Spacing="14">
                <Image x:Name="AboutLogo" Width="48" Height="48" Stretch="Uniform"/>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="RabbitControl" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                  <TextBlock x:Name="AboutVersion" Text="" Style="{StaticResource CaptionText}"/>
                </StackPanel>
              </StackPanel>
              <TextBlock Text="低延迟远程桌面控制系统。被控需本人显式开启；连接默认协商端到端加密。" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
              <Border Height="1" Background="{ThemeResource DividerBrush}"/>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Button x:Name="AboutRepo" Content="开源仓库" Style="{StaticResource LinkButton}"/>
                <Button x:Name="AboutIssues" Content="问题反馈" Style="{StaticResource LinkButton}"/>
              </StackPanel>
              <TextBlock Text="基于 RabbitControl Core · AGPL-3.0" Style="{StaticResource CaptionText}"/>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </StackPanel>
    </Border>
  </Grid>

  <!-- ===== 登录浮层（沉浸式：覆盖全窗，自带右上角按钮） ===== -->
  <Grid x:Name="LoginOverlay" Grid.Row="0" Grid.RowSpan="2" Visibility="Visible">
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EAF4FF" Offset="0"/>
        <GradientStop Color="#F5F0FF" Offset="1"/>
      </LinearGradientBrush>
    </Grid.Background>
    <!-- 沉浸式：右上角最小化/关闭 + 顶部可拖动区（无标题栏文字与图标） -->
    <Border x:Name="LoginDragRegion" Height="40" VerticalAlignment="Top" Background="Transparent"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
      <Button x:Name="LoginMinimize" AutomationProperties.Name="最小化" Content="&#xE921;" Style="{StaticResource CaptionButton}"/>
      <Button x:Name="LoginClose" AutomationProperties.Name="关闭" Content="&#xE8BB;" Style="{StaticResource CaptionCloseButton}"/>
    </StackPanel>
    <!-- 登录视图：定宽居中（窗口恒 1000×660 逻辑尺寸，内容必容纳，无需滚动） -->
    <StackPanel x:Name="LoginView" Width="360" HorizontalAlignment="Center" VerticalAlignment="Center">
      <!-- 品牌 logo 区域 -->
      <StackPanel HorizontalAlignment="Center" Margin="0,0,0,24">
        <Image x:Name="BrandLogo" Width="80" Height="80" HorizontalAlignment="Center" Margin="0,0,0,4"/>
        <TextBlock Text="RabbitControl" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
        <TextBlock Text="远程桌面 · 账号登录" HorizontalAlignment="Center" Foreground="{ThemeResource TextTertiaryBrush}" FontSize="13" Margin="0,6,0,0"/>
      </StackPanel>
      <!-- 表单卡片 -->
      <Border Background="White" CornerRadius="14" Padding="20,22" BorderBrush="#E8E8F0" BorderThickness="1" Width="360" HorizontalAlignment="Center">
        <StackPanel Spacing="0">
          <TextBlock Text="账号邮箱" Style="{StaticResource FieldLabel}"/>
          <TextBox x:Name="Email" Style="{StaticResource SoftTextBox}" AutomationProperties.Name="账号邮箱" PlaceholderText="请输入邮箱地址"
                   Padding="12,9" Margin="0,6,0,14" FontSize="14" InputScope="EmailSmtpAddress"/>
          <TextBlock Text="密码" Style="{StaticResource FieldLabel}"/>
          <PasswordBox x:Name="Password" Style="{StaticResource SoftPasswordBox}" AutomationProperties.Name="密码" PlaceholderText="请输入密码"
                       Padding="12,9" Margin="0,6,0,0" FontSize="14"/>
          <TextBlock x:Name="LoginError" Foreground="{ThemeResource DangerBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/>
          <Button x:Name="SignIn" Content="登录" Style="{StaticResource PrimaryButton}" Height="42" Margin="0,16,0,0"
                  HorizontalAlignment="Stretch"/>
        </StackPanel>
      </Border>
      <!-- 底部服务器信息 -->
      <Grid Margin="0,14,0,0">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE968;" FontSize="13" Foreground="{ThemeResource TextTertiaryBrush}"/>
          <TextBlock x:Name="ServerCaption" MaxWidth="220" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{ThemeResource TextTertiaryBrush}"/>
        </StackPanel>
        <Button x:Name="ServerLink" HorizontalAlignment="Right" Content="服务器设置" Style="{StaticResource LinkButton}"/>
      </Grid>
    </StackPanel>

    <!-- 服务器设置视图 -->
    <StackPanel x:Name="ServerSettingsView" Visibility="Collapsed" Width="360" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Button x:Name="BackToLogin" Content="‹  返回登录" Style="{StaticResource LinkButton}" Margin="-8,0,0,18"/>
      <Border Background="White" CornerRadius="14" Padding="20,22" BorderBrush="#E8E8F0" BorderThickness="1">
        <StackPanel Spacing="0">
          <TextBlock Text="服务器设置" Style="{StaticResource SubtitleText}"/>
          <TextBlock Text="连接时将自动探测服务器并校验 Root CA 证书。" FontSize="13" Foreground="{ThemeResource TextTertiaryBrush}" Margin="0,8,0,20" TextWrapping="Wrap"/>
          <TextBlock Text="服务器地址" Style="{StaticResource FieldLabel}"/>
          <TextBox x:Name="Origin" Style="{StaticResource SoftTextBox}" AutomationProperties.Name="服务器地址" PlaceholderText="https://主机:端口" FontSize="14"
                   Padding="12,9" Margin="0,6,0,6"/>
          <TextBlock Text="仅填主机名时使用 HTTPS 和端口 21118，也可输入完整地址。本机调试支持 HTTP。" FontSize="12" Foreground="{ThemeResource TextTertiaryBrush}" TextWrapping="Wrap"/>
          <TextBlock x:Name="SettingsError" Foreground="{ThemeResource DangerBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
          <Button x:Name="SaveServer" Content="保存地址" Style="{StaticResource PrimaryButton}" Height="42" Margin="0,16,0,0"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </Grid>

  <!-- 轻提示（顶部居中，几秒后自动消失）：复制成功、已安全锁定这类一句话反馈 -->
  <Border x:Name="Toast" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,52,0,0" Background="#E61D2129" CornerRadius="8" Padding="14,7" Visibility="Collapsed" IsHitTestVisible="False">
    <TextBlock x:Name="ToastText" Text="" FontSize="13" Foreground="White"/>
  </Border>
</Grid>
