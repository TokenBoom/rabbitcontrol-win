<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      RequestedTheme="Dark" x:Name="SessionWindowRoot"
      Background="{ThemeResource DarkWindowBrush}">
  <!-- ===== 独立会话窗口（M3.6：唯一允许自由缩放的窗口，min 640×400） =====
       形态对齐主流远程桌面：画面占满，顶部只留一条 40 的状态条；不常驻任何带边框的按钮，
       操作都是图标（悬停出薄雾、按下沉一下），说明靠 ToolTip。 -->
  <Grid.Resources>
    <!-- 输入框的深色版：填充色与悬停 / 聚焦描边就近覆盖应用级字典里的浅色值
         （这扇窗口是 Dark，锁定验证、端口映射、输入提示里的文本框要跟着变深） -->
    <Color x:Key="FieldFillColor">#1A2029</Color>
    <SolidColorBrush x:Key="FieldFillBrush" Color="{StaticResource FieldFillColor}"/>
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource FieldFillColor}"/>
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource FieldFillColor}"/>
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#2B3442"/>
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#5B86FF"/>
    <!-- 下拉菜单的深色版（画质菜单）：面板与卡片同色，悬停抬一档，不用系统那种发灰的白 -->
    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#171D27"/>
    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#2B3442"/>
    <SolidColorBrush x:Key="MenuFlyoutItemBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#222A37"/>
    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#2B3442"/>
    <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="#E7ECF4"/>
    <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="#E7ECF4"/>
    <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="#E7ECF4"/>
    <SolidColorBrush x:Key="MenuFlyoutSubItemBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="MenuFlyoutSubItemBackgroundPointerOver" Color="#222A37"/>
    <SolidColorBrush x:Key="MenuFlyoutSubItemForeground" Color="#E7ECF4"/>
    <SolidColorBrush x:Key="MenuFlyoutSubItemForegroundPointerOver" Color="#E7ECF4"/>
    <SolidColorBrush x:Key="MenuFlyoutSubItemChevronForeground" Color="#6C7A90"/>
    <SolidColorBrush x:Key="MenuFlyoutSeparatorBackground" Color="#1E2530"/>
    <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground" Color="#6C7A90"/>
    <!-- 工具面板滑入 -->
    <Storyboard x:Name="PanelIn">
      <DoubleAnimation Storyboard.TargetName="ToolPanelContent" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18">
        <DoubleAnimation.EasingFunction><ExponentialEase EasingMode="EaseOut" Exponent="5"/></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="ToolPanelContent" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateX)" From="-16" To="0" Duration="0:0:0.2">
        <DoubleAnimation.EasingFunction><ExponentialEase EasingMode="EaseOut" Exponent="5"/></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
    </Storyboard>
    <!-- 切 tab：内容区轻微淡入 -->
    <Storyboard x:Name="PaneIn">
      <DoubleAnimation Storyboard.TargetName="PaneHost" Storyboard.TargetProperty="Opacity" From="0.35" To="1" Duration="0:0:0.16"/>
    </Storyboard>
    <!-- 终端轻提示落下 -->
    <Storyboard x:Name="ToastIn">
      <DoubleAnimation Storyboard.TargetName="TerminalToast" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18"/>
      <DoubleAnimation Storyboard.TargetName="TerminalToast" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)" From="-10" To="0" Duration="0:0:0.2">
        <DoubleAnimation.EasingFunction><ExponentialEase EasingMode="EaseOut" Exponent="5"/></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
    </Storyboard>
    <!-- 连接中：三点脉冲（由代码 Begin / 停下） -->
    <Storyboard x:Name="SpinnerPulse">
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot1" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.3"/>
        <SplineDoubleKeyFrame KeyTime="0:0:0.18" Value="1"/>
        <SplineDoubleKeyFrame KeyTime="0:0:0.5" Value="0.3"/>
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot2" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.14" RepeatBehavior="Forever">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.3"/>
        <SplineDoubleKeyFrame KeyTime="0:0:0.18" Value="1"/>
        <SplineDoubleKeyFrame KeyTime="0:0:0.5" Value="0.3"/>
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot3" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.28" RepeatBehavior="Forever">
        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.3"/>
        <SplineDoubleKeyFrame KeyTime="0:0:0.18" Value="1"/>
        <SplineDoubleKeyFrame KeyTime="0:0:0.5" Value="0.3"/>
      </DoubleAnimationUsingKeyFrames>
    </Storyboard>
  </Grid.Resources>

  <Grid.RowDefinitions>
    <RowDefinition Height="40"/>
    <RowDefinition Height="*"/>
  </Grid.RowDefinitions>

  <!-- ===== 顶部状态条：状态点 + 设备名 + 连接信息；右侧全是图标 ===== -->
  <Border Background="{ThemeResource DarkChromeBrush}" BorderBrush="{ThemeResource DarkStrokeBrush}" BorderThickness="0,0,0,1">
    <Grid Margin="12,0,8,0">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Ellipse x:Name="SessionDot" Width="8" Height="8" Fill="{ThemeResource DarkPendingBrush}" VerticalAlignment="Center"/>
        <TextBlock x:Name="SessionStatus" Text="正在连接…" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource DarkTextBrush}"
                   VerticalAlignment="Center" MaxWidth="420" TextTrimming="CharacterEllipsis"/>
        <!-- 连接信息（分辨率 / 帧率 / 传输方式）：谈出来的才有，所以默认收着 -->
        <Border x:Name="SessionBackendChip" Background="{ThemeResource DarkRaisedBrush}" CornerRadius="6" Padding="8,2" VerticalAlignment="Center" Visibility="Collapsed">
          <TextBlock x:Name="SessionBackend" Text="" FontSize="11" Foreground="{ThemeResource DarkText2Brush}" VerticalAlignment="Center"/>
        </Border>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
        <ToggleButton x:Name="ToolToggle" Style="{StaticResource GhostToggleButton}" AutomationProperties.Name="工具面板" ToolTipService.ToolTip="工具（终端 / 文件 / 端口映射）">
          <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE90F;" FontSize="16"/>
        </ToggleButton>
        <Button x:Name="SessionQuality" Style="{StaticResource GhostIconButton}" AutomationProperties.Name="显示与画质" ToolTipService.ToolTip="显示与画质">
          <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE714;" FontSize="16"/>
          <Button.Flyout>
            <MenuFlyout x:Name="QualityMenu" Placement="BottomEdgeAlignedRight"/>
          </Button.Flyout>
        </Button>
        <Button x:Name="SessionFullscreen" Style="{StaticResource GhostIconButton}" AutomationProperties.Name="全屏" ToolTipService.ToolTip="全屏（Esc 退出）">
          <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE740;" FontSize="16"/>
        </Button>
        <!-- 重新连接只在会话结束后出现 -->
        <Button x:Name="SessionReconnect" Style="{StaticResource GhostIconButton}" AutomationProperties.Name="重新连接" ToolTipService.ToolTip="重新连接" Visibility="Collapsed">
          <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72C;" FontSize="16"/>
        </Button>
        <Button x:Name="SessionDisconnect" Style="{StaticResource GhostDangerButton}" AutomationProperties.Name="断开连接" ToolTipService.ToolTip="断开连接">
          <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7E8;" FontSize="16"/>
        </Button>
      </StackPanel>
    </Grid>
  </Border>

  <Grid Grid.Row="1">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ===== 工具面板（宽度随 tab 变化，右侧分隔条可拖） ===== -->
    <Border x:Name="ToolPanel" Visibility="Collapsed" Width="340" Background="{ThemeResource DarkPanelBrush}" BorderBrush="{ThemeResource DarkStrokeBrush}" BorderThickness="0,0,1,0">
      <Grid x:Name="ToolPanelContent">
        <Grid.RenderTransform>
          <CompositeTransform/>
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
          <RowDefinition Height="44"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 面板头部：左边一条分段开关，右边是当前 tab 才用得上的操作 -->
        <Grid Margin="10,7,8,3">
          <Border Background="{ThemeResource DarkInsetBrush}" CornerRadius="8" Padding="2" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
              <ToggleButton x:Name="ToolTabTerminal" Style="{StaticResource SegmentTab}" IsChecked="True">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE756;" FontSize="13"/>
                  <TextBlock Text="终端" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
              </ToggleButton>
              <ToggleButton x:Name="ToolTabFiles" Style="{StaticResource SegmentTab}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8AB;" FontSize="13"/>
                  <TextBlock Text="文件" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
              </ToggleButton>
              <ToggleButton x:Name="ToolTabPortmap" Style="{StaticResource SegmentTab}" Margin="0">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8AC;" FontSize="13"/>
                  <TextBlock Text="端口" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
              </ToggleButton>
            </StackPanel>
          </Border>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
            <StackPanel x:Name="TerminalActions" Orientation="Horizontal" Spacing="2">
              <!-- 结束只在终端开着时出现 -->
              <Button x:Name="TerminalClose" Style="{StaticResource GhostSmallButton}" AutomationProperties.Name="结束终端" ToolTipService.ToolTip="结束当前终端" Visibility="Collapsed">
                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE711;" FontSize="14"/>
              </Button>
              <Button x:Name="TerminalNew" Style="{StaticResource GhostSmallButton}" AutomationProperties.Name="新终端" ToolTipService.ToolTip="新终端">
                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE710;" FontSize="14"/>
              </Button>
            </StackPanel>
            <StackPanel x:Name="FileActions" Orientation="Horizontal" Spacing="2" Visibility="Collapsed">
              <Button x:Name="FileUploadPick" Style="{StaticResource GhostSmallButton}" AutomationProperties.Name="上传到远端" ToolTipService.ToolTip="上传文件到远端">
                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE898;" FontSize="14"/>
              </Button>
              <Button x:Name="FileDownloadPick" Style="{StaticResource GhostSmallButton}" AutomationProperties.Name="下载远端文件" ToolTipService.ToolTip="下载远端文件">
                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE896;" FontSize="14"/>
              </Button>
            </StackPanel>
          </StackPanel>
        </Grid>

        <Grid x:Name="PaneHost" Grid.Row="1">
          <!-- 终端：真终端（VT 屏幕模型 + 按列定位的自绘网格，见 terminal_view.rs）。
               两层画布：TerminalBg 画底色条 / 选区 / 光标，TerminalFg 画文本；元素按行复用，不每帧重建。
               TerminalIme 是一个透明的小输入框：承接可打印字符与输入法，其余按键在 PreviewKeyDown 里编码后直接发送。 -->
          <Grid x:Name="TerminalPane" Margin="4,0,4,4">
            <Border Background="{ThemeResource DarkTerminalBrush}" CornerRadius="8" Padding="8,6">
              <Grid x:Name="TerminalHost" Background="Transparent">
                <Canvas x:Name="TerminalBg"/>
                <Canvas x:Name="TerminalFg"/>
                <!-- 滚动条滑块与输入框要按格子坐标定位，而 Canvas.Left / Top 只对 Canvas 的直接子元素生效：
                     所以单独放一层与画面同大的 Canvas，两者都是它的直接子元素 -->
                <Canvas x:Name="TerminalOverlay">
                  <Rectangle x:Name="TerminalThumb" Fill="{ThemeResource DarkStrokeStrongBrush}" RadiusX="2" RadiusY="2" Width="4" Visibility="Collapsed"/>
                  <TextBox x:Name="TerminalIme" Opacity="0" Width="2" Height="2" MinWidth="0" MinHeight="0" Padding="0" BorderThickness="0"
                           Background="Transparent" Foreground="Transparent" FontSize="1" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                           AcceptsReturn="True" TextWrapping="NoWrap" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Hidden"
                           AutomationProperties.Name="终端输入"/>
                </Canvas>

                <!-- 空态：还没开终端时的引导，按钮就是唯一的下一步 -->
                <StackPanel x:Name="TerminalEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                  <Border Width="52" Height="52" CornerRadius="14" Background="{ThemeResource DarkAccentTintBrush}" HorizontalAlignment="Center">
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE756;" FontSize="22" Foreground="{ThemeResource DarkAccentBrush}"/>
                  </Border>
                  <TextBlock Text="远程终端" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource DarkTextBrush}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                  <TextBlock Text="在远端设备上打开命令行，直接在这里敲命令" FontSize="12" Foreground="{ThemeResource DarkText3Brush}" HorizontalAlignment="Center"/>
                  <Button x:Name="TerminalOpenCta" Content="打开终端" Style="{StaticResource DarkPrimaryButton}" Margin="0,14,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- 轻提示：只在有话要说时出现（打开失败、对方不允许用终端…） -->
                <Border x:Name="TerminalToast" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,16,0" MaxWidth="480"
                        Background="{ThemeResource DarkCardBrush}" BorderBrush="{ThemeResource DarkStrokeStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6"
                        Visibility="Collapsed" Canvas.ZIndex="6">
                  <Border.RenderTransform>
                    <CompositeTransform/>
                  </Border.RenderTransform>
                  <TextBlock x:Name="TerminalHint" Text="" FontSize="12" Foreground="{ThemeResource DarkText2Brush}" TextWrapping="Wrap" MaxWidth="456"/>
                </Border>

                <!-- 翻看历史时下面又来了新输出：点一下回到底部 -->
                <Button x:Name="TerminalBehind" Content="↓ 新输出" Style="{StaticResource DarkSoftButton}" Height="28" Padding="12,0" FontSize="12"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,8" Visibility="Collapsed" Canvas.ZIndex="5"/>

                <!-- 被控端锁屏时：验证系统密码后才能用终端（只校验密码，不解锁屏幕） -->
                <Border x:Name="TerminalLock" Background="{ThemeResource DarkCardBrush}" BorderBrush="{ThemeResource DarkStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="18,16" Visibility="Collapsed" Canvas.ZIndex="8">
                  <StackPanel Spacing="8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <Border Width="36" Height="36" CornerRadius="10" Background="#33F0B429">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72E;" FontSize="16" Foreground="#F5C242"/>
                      </Border>
                      <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="被控端已锁屏" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource DarkTextBrush}"/>
                        <TextBlock Text="验证系统密码后可以继续用终端（不会解锁屏幕）" FontSize="12" Foreground="{ThemeResource DarkText3Brush}" TextWrapping="Wrap"/>
                      </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="TerminalLockUser" Text="" FontSize="12" Foreground="{ThemeResource DarkText2Brush}" TextWrapping="Wrap" Visibility="Collapsed"/>
                    <TextBox x:Name="TerminalLockUsername" Style="{StaticResource SoftTextBox}" PlaceholderText="系统用户名" Visibility="Collapsed"/>
                    <PasswordBox x:Name="TerminalLockPassword" Style="{StaticResource SoftPasswordBox}" PlaceholderText="系统登录密码"/>
                    <TextBlock x:Name="TerminalLockError" Text="" FontSize="12" Foreground="{ThemeResource DarkDangerBrush}" TextWrapping="Wrap"/>
                    <Button x:Name="TerminalLockSubmit" Content="验证并继续" Style="{StaticResource DarkPrimaryButton}" HorizontalAlignment="Right"/>
                  </StackPanel>
                </Border>
              </Grid>
            </Border>
          </Grid>

          <!-- 文件传输：选择文件的入口在面板头部（↑ ↓），这里只有说明和队列 -->
          <Grid x:Name="FilesPane" Visibility="Collapsed" Margin="10,4,4,4">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- 上传 / 下载的进度与结果；平时是空的（操作入口的说明在下面的空态卡片里） -->
            <TextBlock x:Name="FileHint" Text="" FontSize="12" Foreground="{ThemeResource DarkText3Brush}" TextWrapping="Wrap" Margin="0,0,10,0"/>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
              <StackPanel x:Name="TransferList" Spacing="6"/>
            </ScrollViewer>
          </Grid>

          <!-- 端口映射 -->
          <Grid x:Name="PortmapPane" Visibility="Collapsed" Margin="10,4,4,4">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="{ThemeResource DarkInsetBrush}" CornerRadius="8" Padding="12">
              <StackPanel Spacing="8">
                <TextBlock Text="新增映射" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource DarkText2Brush}"/>
                <TextBox x:Name="PortmapName" Style="{StaticResource SoftTextBox}" PlaceholderText="名称（可选）"/>
                <TextBox x:Name="PortmapLocalPort" Style="{StaticResource SoftTextBox}" PlaceholderText="本地端口，如 8080"/>
                <TextBox x:Name="PortmapTargetAddr" Style="{StaticResource SoftTextBox}" PlaceholderText="被控端目标地址，如 127.0.0.1"/>
                <TextBox x:Name="PortmapTargetPort" Style="{StaticResource SoftTextBox}" PlaceholderText="被控端目标端口"/>
                <Button x:Name="PortmapAdd" Content="添加映射" Style="{StaticResource DarkPrimaryButton}" HorizontalAlignment="Right"/>
                <TextBlock x:Name="PortmapError" FontSize="12" Foreground="{ThemeResource DarkDangerBrush}" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
              <StackPanel x:Name="PortmapList" Spacing="6"/>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Grid>
    </Border>
    <!-- 工具面板右缘的分隔条：拖动改面板宽度；悬停时亮起一根蓝线 -->
    <Border x:Name="ToolSplitter" Grid.Column="0" Width="8" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="Transparent" Visibility="Collapsed">
      <Border x:Name="ToolSplitterGlow" Width="2" HorizontalAlignment="Center" Background="{ThemeResource PrimaryBrush}" Opacity="0" CornerRadius="1"/>
    </Border>

    <!-- ===== 远程画面 ===== -->
    <Grid Grid.Column="1" x:Name="SessionStage" Background="{ThemeResource DarkStageBrush}">
    <SwapChainPanel x:Name="SessionPanel"/>
    <StackPanel x:Name="SessionOverlay" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" IsHitTestVisible="False">
      <!-- 连接中：三点脉冲（SpinnerPulse）；结束时收起，只留文字 -->
      <Grid x:Name="SessionSpinner" Width="76" Height="16" HorizontalAlignment="Center">
        <Ellipse x:Name="Dot1" Width="10" Height="10" Fill="{ThemeResource PrimaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.3"/>
        <Ellipse x:Name="Dot2" Width="10" Height="10" Fill="{ThemeResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.3"/>
        <Ellipse x:Name="Dot3" Width="10" Height="10" Fill="{ThemeResource PrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.3"/>
      </Grid>
      <TextBlock x:Name="SessionOverlayText" Text="" Foreground="{ThemeResource DarkText2Brush}" FontSize="14" HorizontalAlignment="Center" MaxWidth="560" TextWrapping="Wrap" TextAlignment="Center"/>
    </StackPanel>
    <Border x:Name="SessionHudPanel" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="10" Background="{ThemeResource DarkGlassBrush}" BorderBrush="{ThemeResource DarkStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="10,7" IsHitTestVisible="False" Visibility="Collapsed">
      <TextBlock x:Name="SessionHud" Text="" FontFamily="Consolas" FontSize="12" Foreground="#BFE8CB" LineHeight="17"/>
    </Border>
    </Grid>
  </Grid>

  <!-- 输入提示浮层（下载远端路径等） -->
  <Grid x:Name="PromptOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="{ThemeResource DarkScrimBrush}">
    <Border Width="360" Style="{StaticResource DarkCardBorder}" Padding="18">
      <StackPanel Spacing="10">
        <TextBlock x:Name="PromptTitle" Text="输入" Style="{StaticResource DarkSubtitleText}"/>
        <TextBox x:Name="PromptInput" Style="{StaticResource SoftTextBox}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
          <Button x:Name="PromptCancel" Content="取消" Style="{StaticResource DarkSoftButton}"/>
          <Button x:Name="PromptOk" Content="确定" Style="{StaticResource DarkPrimaryButton}" Width="90"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Grid>
