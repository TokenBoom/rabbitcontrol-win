<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" RequestedTheme="Light">
  <Grid.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#3A465C"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Background" Value="#346CFF"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Link" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#385CC3"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#45526C"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="10"/>
    </Style>
  </Grid.Resources>
  <Grid.RowDefinitions>
    <RowDefinition Height="36"/><RowDefinition Height="*"/>
  </Grid.RowDefinitions>
  <Grid.Background>
    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.4">
      <GradientStop Color="#D7F3FF" Offset="0"/>
      <GradientStop Color="#E0EEFF" Offset="0.52"/>
      <GradientStop Color="#E9E4FF" Offset="1"/>
    </LinearGradientBrush>
  </Grid.Background>
  <Rectangle Grid.RowSpan="2" IsHitTestVisible="False">
    <Rectangle.Fill>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00FFFFFF" Offset="0"/>
        <GradientStop Color="#B9FFFFFF" Offset="0.34"/>
        <GradientStop Color="#FFFFFFFF" Offset="0.70"/>
      </LinearGradientBrush>
    </Rectangle.Fill>
  </Rectangle>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <Border x:Name="DragRegion" Background="Transparent" IsDoubleTapEnabled="True"/>
    <StackPanel Grid.Column="1" Orientation="Horizontal">
      <Button x:Name="Minimize" AutomationProperties.Name="最小化" Content="&#xE921;" Style="{StaticResource CaptionButton}"/>
      <Button x:Name="Maximize" AutomationProperties.Name="最大化" Content="&#xE922;" Style="{StaticResource CaptionButton}"/>
      <Button x:Name="CloseWindow" AutomationProperties.Name="关闭" Content="&#xE8BB;" Style="{StaticResource CaptionButton}"/>
    </StackPanel>
  </Grid>
  <ScrollViewer Grid.Row="1" x:Name="LoginPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                MaxWidth="400" VerticalAlignment="Center" HorizontalContentAlignment="Stretch">
    <StackPanel Margin="24,24">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="11" Margin="0,0,0,12">
        <Viewbox Width="47" Height="48" AutomationProperties.AccessibilityView="Raw">
          <Canvas Width="52" Height="52">
            <Path Fill="#6C7DFF" Data="M 16,28 L 13,6 Q 13,3 16,4 L 27,23 Z"/>
            <Path Fill="#3569FA" Data="M 25,26 L 33,2 Q 34,0 36,3 L 39,24 L 32,32 Z"/>
            <Path Fill="#00BFEF" Data="M 2,26 L 21,21 L 33,32 L 20,45 Z"/>
            <Path Fill="#3875FF" Data="M 21,21 L 39,23 L 50,31 L 32,38 Z"/>
            <Path Fill="#254ED8" Data="M 20,45 L 32,31 L 39,37 L 28,50 Z"/>
          </Canvas>
        </Viewbox>
        <TextBlock VerticalAlignment="Center" Text="RabbitControl" FontSize="33" FontWeight="Bold" Foreground="#151E31"/>
      </StackPanel>
      <TextBlock Text="远程桌面 · 账号登录" HorizontalAlignment="Center" Foreground="#64718A" FontSize="15" Margin="0,0,0,35"/>
      <TextBlock Text="账号邮箱" Style="{StaticResource FieldLabel}"/>
      <TextBox x:Name="Email" AutomationProperties.Name="账号邮箱" PlaceholderText="请输入邮箱地址"
               Background="Transparent" BorderBrush="#BBC8D9" BorderThickness="0,0,0,1"
               Padding="0,9" Margin="0,3,0,18" FontSize="15" InputScope="EmailSmtpAddress"/>
      <TextBlock Text="密码" Style="{StaticResource FieldLabel}"/>
      <PasswordBox x:Name="Password" AutomationProperties.Name="密码" PlaceholderText="请输入密码"
                   Background="Transparent" BorderBrush="#BBC8D9" BorderThickness="0,0,0,1"
                   Padding="0,9" Margin="0,3,0,0" FontSize="15"/>
      <TextBlock x:Name="LoginError" Foreground="#A93838" TextWrapping="Wrap" FontSize="13" Margin="0,6,0,0"/>
      <Button x:Name="SignIn" Content="登录" Style="{StaticResource Primary}" Margin="0,12,0,14"/>
      <Grid>
        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
          <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE968;" FontSize="14" Foreground="#68768D"/>
          <TextBlock x:Name="ServerCaption" MaxWidth="206" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="#68768D"/>
        </StackPanel>
        <Button x:Name="Settings" HorizontalAlignment="Right" Content="服务器设置" Style="{StaticResource Link}"/>
      </Grid>
    </StackPanel>
  </ScrollViewer>
  <ScrollViewer Grid.Row="1" x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled" MaxWidth="400" VerticalAlignment="Center" HorizontalContentAlignment="Stretch">
    <StackPanel Margin="24,24">
      <Button x:Name="Back" Content="‹  返回登录" Style="{StaticResource Link}" Margin="-8,0,0,22"/>
      <TextBlock Text="服务器设置" FontSize="28" FontWeight="SemiBold" Foreground="#151E31"/>
      <TextBlock Text="连接时将自动探测服务器并校验 Root CA 证书。" FontSize="14" Foreground="#64718A" Margin="0,10,0,30" TextWrapping="Wrap"/>
      <TextBlock Text="服务器地址" Style="{StaticResource FieldLabel}"/>
      <TextBox x:Name="Origin" AutomationProperties.Name="服务器地址" PlaceholderText="https://主机:端口" FontSize="15" Margin="0,6,0,8"/>
      <TextBlock Text="仅填主机名时使用 HTTPS 和端口 21118，也可输入完整地址。本机调试支持 HTTP。" FontSize="12" Foreground="#68768D" TextWrapping="Wrap"/>
      <TextBlock x:Name="SettingsError" Foreground="#A93838" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0"/>
      <Button x:Name="Save" Content="保存地址" Style="{StaticResource Primary}" Margin="0,14,0,0"/>
    </StackPanel>
  </ScrollViewer>
  <Grid Grid.Row="1" x:Name="DesktopPage" Visibility="Collapsed" Background="#F3F7FB">
    <Grid.RowDefinitions>
      <RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="42"/>
    </Grid.RowDefinitions>
    <Grid Margin="24,0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7F4;" Foreground="#346CFF"/>
        <TextBlock Text="远程桌面" FontSize="20" FontWeight="SemiBold"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="10">
        <TextBlock x:Name="LocalDeviceId" FontFamily="Consolas" VerticalAlignment="Center" Foreground="#346CFF" FontWeight="SemiBold"/>
        <TextBlock x:Name="Account" MaxWidth="210" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="#516278"/>
        <Button x:Name="RefreshDevices" Content="刷新设备" Style="{StaticResource Link}"/>
        <Button x:Name="SignOut" Content="退出登录" Style="{StaticResource Link}"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1" Margin="20,0" Background="#101922" BorderBrush="#CDD8E4" BorderThickness="1">
      <Viewbox Stretch="Uniform"><SwapChainPanel x:Name="Framebuffer"/></Viewbox>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="560" IsHitTestVisible="False">
        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7F4;" FontSize="40" Foreground="#ADC9FF"/>
        <TextBlock Text="暂无远程会话" HorizontalAlignment="Center" Foreground="White" FontSize="21" FontWeight="SemiBold"/>
        <TextBlock x:Name="DeviceSummary" Foreground="#C5D4E8" FontSize="13" TextAlignment="Center" TextWrapping="Wrap"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="2" Margin="24,0">
      <TextBlock x:Name="DesktopServer" FontSize="13" VerticalAlignment="Center" Foreground="#586A81"/>
      <TextBlock x:Name="DesktopSize" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#586A81"/>
    </Grid>
  </Grid>
</Grid>
